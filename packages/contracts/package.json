{
  "name": "@agroconnect/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos API de AgroConnect: esquemas Zod, tipos inferidos y OpenAPI 3.1. Fuente única de validación para backend, frontend, móvil y satélite Python (ADR-015, contract-first)",
  "main": "./dist/cjs/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "src"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --platform=node --outfile=dist/cjs/index.js --external:zod",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/esm/index.mjs --external:zod",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:drift": "tsx scripts/check-drift.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
