{
  "name": "@agroconnect/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Contratos API de AgroConnect: esquemas Zod, tipos inferidos y OpenAPI 3.1. Fuente única de validación para backend, frontend, móvil y satélite Python (ADR-015, contract-first)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "check:drift": "tsx scripts/check-drift.ts"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
