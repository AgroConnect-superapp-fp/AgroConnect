{
  "openapi": "3.1.0",
  "info": {
    "title": "AgroConnect API",
    "version": "1.0.0",
    "description": "Contrato de la API REST de AgroConnect (plataforma B2B+B2C agropecuaria para Colombia rural). Generado desde los esquemas Zod de @agroconnect/contracts (ADR-015, contract-first). Los códigos de error listados son el contrato mínimo; el detalle fino por endpoint se documentará con la migración a NestJS (ADR-009)."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registra un nuevo usuario (productor, comprador o transportista)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequestBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado; se envía correo de verificación"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "409": {
            "description": "Correo o documento ya registrados"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Autentica un usuario y emite tokens JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens de acceso y refresco emitidos"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "401": {
            "description": "Credenciales inválidas o correo sin verificar"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Renueva el par de tokens con un refresh token válido",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nuevos tokens emitidos"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "401": {
            "description": "Refresh token inválido, expirado o revocado"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Revoca la sesión del refresh token entregado",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequestBody"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sesión revocada"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Envía un correo con el enlace de recuperación",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta neutra; no revela si el correo existe"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Restablece la contraseña con un token de recuperación",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada correctamente"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "401": {
            "description": "Token de recuperación inválido o expirado"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Verifica el correo con el token del enlace",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Correo verificado correctamente"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "401": {
            "description": "Token de verificación inválido o expirado"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Reenvía el correo de verificación",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationRequestBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Respuesta neutra; no revela si el correo existe"
          },
          "400": {
            "description": "Solicitud malformada o cuerpo inválido"
          },
          "422": {
            "description": "Reglas de negocio incumplidas (detalles por campo)"
          },
          "429": {
            "description": "Demasiadas solicitudes: límite de tasa aplicado"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RegisterRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "documento": {
            "type": "string",
            "pattern": "^\\d{6,12}$"
          },
          "correo": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "celular": {
            "type": "string",
            "pattern": "^3\\d{9}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          },
          "rol": {
            "type": "string",
            "enum": [
              "productor",
              "comprador_b2c",
              "comprador_b2b",
              "transportista"
            ]
          },
          "finca": {
            "type": "object",
            "properties": {
              "nombre": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "municipio": {
                "type": "string",
                "minLength": 3,
                "maxLength": 120
              },
              "vereda": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "latitud": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "longitud": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            },
            "required": [
              "nombre",
              "municipio",
              "vereda"
            ],
            "additionalProperties": false
          },
          "empresa": {
            "type": "object",
            "properties": {
              "razonSocial": {
                "type": "string",
                "minLength": 3,
                "maxLength": 160
              },
              "nit": {
                "type": "string",
                "pattern": "^\\d{9,10}(-\\d)?$"
              },
              "direccion": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "razonSocial",
              "nit"
            ],
            "additionalProperties": false
          },
          "aceptaTratamientoDatos": {
            "type": "boolean"
          }
        },
        "required": [
          "nombre",
          "documento",
          "correo",
          "celular",
          "password",
          "rol",
          "aceptaTratamientoDatos"
        ],
        "additionalProperties": false
      },
      "LoginRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "correo",
          "password"
        ],
        "additionalProperties": false
      },
      "RefreshRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ],
        "additionalProperties": false
      },
      "LogoutRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ],
        "additionalProperties": false
      },
      "ForgotPasswordRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "correo"
        ],
        "additionalProperties": false
      },
      "ResetPasswordRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": [
          "token",
          "password"
        ],
        "additionalProperties": false
      },
      "VerifyEmailRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "ResendVerificationRequestBody": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "correo": {
            "type": "string",
            "format": "email",
            "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "correo"
        ],
        "additionalProperties": false
      }
    }
  }
}
