{
  "name": "agroconnect",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo de AgroConnect — plataforma B2B+B2C agropecuaria para Colombia rural (SENA ADSO, Ficha 3292136). ADR-015: npm workspaces + Turborepo, desarrollo contract-first",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@12.2.0",
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate:openapi": "npm run generate:openapi --workspace @agroconnect/contracts",
    "check:drift": "npm run check:drift --workspace @agroconnect/contracts"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.1"
  }
}
