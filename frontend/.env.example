# ──────────────────────────────────────────────────────────────
# AgroConnect — Frontend · Plantilla de variables de entorno
# Copiar como .env.local y completar. NUNCA commitear el .env.local real.
# ──────────────────────────────────────────────────────────────

# Cloudinary (solo valores públicos para subidas sin firma desde el navegador)
VITE_CLOUDINARY_CLOUD_NAME=tu_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=tu_upload_preset

# Supabase (proyecto del prototipo del mercado — en migración a la API propia)
# La API key anónima es pública por diseño, pero SIEMPRE va por variable de
# entorno; nunca hardcodeada en el código fuente.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key

# Backend propio (API REST)
VITE_API_URL=http://localhost:4000
