# ──────────────────────────────────────────────────────────────
# AgroConnect · API NestJS (@agroconnect/api) — variables de entorno
# Mismos nombres que el backend legacy (`backend/.env.example`) para que
# `.env` y `render.yaml` sirvan tal cual durante la migración progresiva.
# Copiar como .env y completar. NUNCA commitear el .env real.
# ──────────────────────────────────────────────────────────────

# Servidor
NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL 16 + PostGIS 3.4
DATABASE_URL="postgresql://agroconnect:agroconnect_dev@localhost:5434/agroconnect_dev?schema=public"
TEST_DATABASE_URL="postgresql://agroconnect:agroconnect_dev@localhost:5434/agroconnect_test?schema=public"

# JWT (generar con: openssl rand -hex 32)
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Seguridad
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_ATTEMPTS=5

# CORS (origen del frontend en desarrollo; lista separada por comas)
CORS_ORIGIN=http://localhost:5173

# Saltos de proxy confiables para req.ip (0 en local, 1 en Render)
TRUST_PROXY=0

# Logging
LOG_LEVEL=info

# URLs y correo (usados por el módulo identity en el siguiente paso)
APP_BASE_URL=http://localhost:5173
MAIL_DIR=/tmp/agroconnect-mails
