generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

enum CompanyType {
  restaurante
  plaza_mercado
  distribuidor
  supermercado
  exportador
  otro

  @@map("company_type")
}

enum VehicleType {
  camion
  camioneta
  moto
  furgon

  @@map("vehicle_type")
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @map("nombre")
  description String @map("descripcion")

  users User[]

  @@map("roles")
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  fullName              String     @map("nombre_completo")
  document              String     @unique @map("documento")
  email                 String     @unique @map("correo")
  phone                 String     @unique @map("celular")
  passwordHash          String     @map("password_hash")
  roleId                String     @map("rol_id") @db.Uuid
  status                UserStatus @default(ACTIVO) @map("estado")
  acceptsDataProcessing Boolean    @map("acepta_tratamiento_datos")
  emailVerifiedAt       DateTime?  @map("correo_verificado_en")
  createdAt             DateTime   @default(now()) @map("fecha_registro")
  updatedAt             DateTime   @updatedAt @map("actualizado_en")

  role                    Role                     @relation(fields: [roleId], references: [id])
  producerProfile         ProducerProfile?
  companyProfile          CompanyProfile?
  transporterProfile      TransporterProfile?
  refreshTokens           RefreshToken[]
  plots                   Plot[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  products                Product[]

  @@index([roleId])
  @@map("users")
}

model ProducerProfile {
  id           String                                 @id @default(uuid()) @db.Uuid
  userId       String                                 @unique @map("user_id") @db.Uuid
  farmName     String                                 @map("nombre_finca")
  municipality String                                 @map("municipio")
  village      String                                 @map("vereda")
  coordinates  Unsupported("geography(Point, 4326)")? @map("coordenadas")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("producer_profiles")
}

model CompanyProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @unique @map("user_id") @db.Uuid
  companyName  String       @map("razon_social")
  nit          String       @unique @map("nit")
  address      String?      @map("direccion")
  companyType  CompanyType? @map("tipo_empresa")
  department   String?      @map("departamento")
  municipality String?      @map("municipio")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model TransporterProfile {
  id                     String      @id @default(uuid()) @db.Uuid
  userId                 String      @unique @map("user_id") @db.Uuid
  vehicleType            VehicleType @map("tipo_vehiculo")
  plate                  String      @unique @map("placa")
  capacityKg             Float       @map("capacidad_kg")
  coverageMunicipalities String[]    @map("cobertura_municipios")
  coldChain              Boolean     @default(false) @map("cadena_frio")
  soatExpiresAt          DateTime    @map("soat_vence") @db.Date
  licenseExpiresAt       DateTime    @map("licencia_vence") @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("transporter_profiles")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  generation Int       @default(0) @map("generation")
  expiresAt  DateTime  @map("expira_en")
  revoked    Boolean   @default(false) @map("revocado")
  rotatedAt  DateTime? @map("rotated_at")
  createdAt  DateTime  @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([userId, revoked])
  @@map("refresh_tokens")
}

enum ProductCrop {
  coffee
  cacao
  banana
  sugarcane
  rice
  corn
  cassava
  oil_palm

  @@map("product_crop")
}

enum ProductCertification {
  organic
  rainforest_alliance
  fair_trade
  conventional
  global_gap

  @@map("product_certification")
}

model Product {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  owner         String
  description   String?
  contact       String?
  department    String
  municipality  String
  crop          ProductCrop
  areaHectares  Float                 @map("area_hectares")
  productivity  Int
  certification ProductCertification?
  lat           Float
  lng           Float
  producerId    String?               @map("producer_id") @db.Uuid
  producer      User?                 @relation(fields: [producerId], references: [id], onDelete: SetNull)
  images        Json                  @default("[]")
  coordinates   Json                  @default("[]")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  @@index([crop])
  @@index([department, municipality])
  @@index([createdAt])
  @@index([producerId])
  @@map("products")
}

model Plot {
  id           String                                 @id @default(uuid()) @db.Uuid
  name         String
  areaHectares Float                                  @map("area_hectares")
  municipality String
  department   String
  farmerId     String                                 @map("farmer_id") @db.Uuid
  centroid     Unsupported("geography(Point, 4326)")?
  createdAt    DateTime                               @default(now()) @map("created_at")

  farmer User @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@map("plots")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expira_en")
  usedAt    DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expira_en")
  usedAt    DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
