generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

model Role {
  id          String @id @default(uuid()) @db.Uuid
  name        String @unique @map("nombre")
  description String @map("descripcion")

  users User[]

  @@map("roles")
}

model User {
  id                    String     @id @default(uuid()) @db.Uuid
  fullName              String     @map("nombre_completo")
  document              String     @unique @map("documento")
  email                 String     @unique @map("correo")
  phone                 String     @unique @map("celular")
  passwordHash          String     @map("password_hash")
  roleId                String     @map("rol_id") @db.Uuid
  status                UserStatus @default(ACTIVO) @map("estado")
  acceptsDataProcessing Boolean    @map("acepta_tratamiento_datos")
  emailVerifiedAt       DateTime?  @map("correo_verificado_en")
  createdAt             DateTime   @default(now()) @map("fecha_registro")
  updatedAt             DateTime   @updatedAt @map("actualizado_en")

  role            Role             @relation(fields: [roleId], references: [id])
  producerProfile ProducerProfile?
  companyProfile  CompanyProfile?
  refreshTokens   RefreshToken[]
  plots           Plot[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([roleId])
  @@map("users")
}

model ProducerProfile {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @unique @map("user_id") @db.Uuid
  farmName     String  @map("nombre_finca")
  municipality String  @map("municipio")
  village      String  @map("vereda")
  coordinates  Unsupported("geography(Point, 4326)")? @map("coordenadas")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("producer_profiles")
}

model CompanyProfile {
  id          String  @id @default(uuid()) @db.Uuid
  userId      String  @unique @map("user_id") @db.Uuid
  companyName String  @map("razon_social")
  nit         String  @unique @map("nit")
  address     String? @map("direccion")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("company_profiles")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expira_en")
  revoked   Boolean  @default(false) @map("revocado")
  createdAt DateTime @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Plot {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  areaHectares Float    @map("area_hectares")
  municipality String
  department   String
  farmerId     String   @map("farmer_id") @db.Uuid
  centroid     Unsupported("geography(Point, 4326)")?
  createdAt    DateTime @default(now()) @map("created_at")

  farmer User @relation(fields: [farmerId], references: [id])

  @@index([farmerId])
  @@map("plots")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expira_en")
  usedAt    DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expira_en")
  usedAt    DateTime? @map("usado_en")
  createdAt DateTime  @default(now()) @map("creado_en")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}
