@startuml M16-geolocalizacion-rural
' AgroConnect — M16 Geolocalización y Logística Rural (RF-61 a RF-64)
' Generado para cubrir la deuda documental H11 de PT-ECU-01 v1.1 (Sprint de modelado 2026-10-03)
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

actor "Productor" as Productor
actor "Comprador" as Comprador
actor "Transportista" as Transportista
actor "Administrador" as Admin

rectangle "M16 — Geolocalización y Logística Rural" {
  usecase "Definir Zona de Cobertura\nGeográfica" as UC63
  usecase "Filtrar Productos por\nGeolocalización Cercana" as UC39
  usecase "Calcular Ruta Óptima de\nEntrega Multi-Destino" as UC64
  usecase "Trackear Ubicación en Tiempo\nReal del Transportista" as UC65
  usecase "Consultar Mapa Offline\n(OpenStreetMap)" as Mapa
  usecase "Configurar Zonas con\nPolígonos PostGIS" as PostGIS
}

Productor --> UC63
Admin --> UC63
Admin --> PostGIS
Comprador --> UC39
Transportista --> UC64
Transportista --> UC65

UC64 ..> Mapa : <<include>>
UC64 ..> UC39 : <<include>>
UC63 ..> PostGIS : <<include>>
@enduml
